# Application Environment
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Credentials (Required for Docker compose and PostgreSQL database)
POSTGRES_DB=nutriverse
POSTGRES_USER=nutriverse
POSTGRES_PASSWORD=nutriverse

# Database Connection URLs
DATABASE_URL=postgresql+psycopg2://nutriverse:nutriverse@localhost:5432/nutriverse
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT Secret must be >= 32 chars and not in INSECURE_JWT_SECRETS)
JWT_SECRET=super-secret-development-jwt-key-with-over-32-characters
JWT_EXPIRE_MINUTES=15
COOKIE_SECURE=false

# Rate Limiting Configuration
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_AI_CHAT=10/minute

# External Services (Deferred / Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AI_PROVIDER_API_KEY=
AI_MODEL=
